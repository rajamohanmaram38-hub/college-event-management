# ==========================================
# CampusPulse - Client Firebase Configuration
# ==========================================
# Get these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app config

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend API proxy URL (defaults to /api via vite.config.js proxy)
VITE_API_BASE_URL=/api
